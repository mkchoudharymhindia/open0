rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'orderId', 'createdAt', 'customerName', 'phoneNumber',
        'deliveryAddress', 'city', 'state', 'pincode', 'totalAmount',
        'paymentStatus', 'orderStatus'
      ]) &&
      data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 64 &&
      data.createdAt is string && data.createdAt.size() <= 64 &&
      data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150 &&
      data.phoneNumber is string && data.phoneNumber.size() >= 7 && data.phoneNumber.size() <= 20 &&
      data.deliveryAddress is string && data.deliveryAddress.size() > 0 && data.deliveryAddress.size() <= 500 &&
      data.city is string && data.city.size() > 0 && data.city.size() <= 100 &&
      data.state is string && data.state.size() > 0 && data.state.size() <= 100 &&
      data.pincode is string && data.pincode.size() >= 4 && data.pincode.size() <= 10 &&
      data.totalAmount is number && data.totalAmount >= 0 &&
      data.paymentStatus in ['Payment Details Submitted', 'Payment Verified', 'Payment Failed', 'Refund Initiated', 'Refunded'] &&
      data.orderStatus in ['Processing', 'Shipped', 'Out for Delivery', 'Delivered', 'Cancelled'];
    }

    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow list: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'orderStatus', 'customerNotes', 'utrNumber'])
      );
      allow delete: if isValidId(orderId);
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
